# Copia este archivo a .env y completa los valores reales.
# Consulta el README.md para ver la descripción y ejemplos de cada variable.

# Conexión a MySQL: mysql://usuario:clave@host:3306/basededatos
DATABASE_URL=

# Carpeta persistente de archivos subidos (fuera de .next y del árbol del proyecto).
# En desarrollo local, si se deja vacío, usa public/uploads.
UPLOADS_DIR=

# Requerido en este hosting: limita los hilos internos del motor de Prisma.
TOKIO_WORKER_THREADS=1

# Clave de la API de Google Maps (se incrusta en el build, es pública a propósito).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Contraseña y datos del primer usuario administrador.
# Solo se usan una vez, al correr `node prisma/seed.js` con la tabla User vacía.
ADMIN_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=

# Clave de firma de los tokens de sesión del panel. Genera una nueva con:
# openssl rand -hex 32
SESSION_SECRET=

# Credenciales SMTP para el correo de avisos.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Remitente y destinatario de respaldo de los avisos de solicitudes nuevas.
SOLICITUDES_EMAIL_FROM=
SOLICITUDES_EMAIL_TO=

# URL pública del sitio, sin barra final (ej. https://turismocumpeo.cl).
# Sin esto, el correo de aviso de solicitudes se envía sin el enlace al panel.
SITE_URL=
