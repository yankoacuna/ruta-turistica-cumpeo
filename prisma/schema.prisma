generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Destination {
  id               String   @id
  slug             String   @unique
  nombre           String
  categoria        String
  descripcionCorta String
  descripcionLarga String?
  historia         String?
  coordenadas      Json     // { "lat": -35.267, "lng": -71.250 }
  direccion        String?
  horario          Json?
  duracionVisita   String?
  comoLlegar       String?
  tags             Json     @default("[]") // array de strings
  imagenPrincipal  String?
  galeria          Json     @default("[]") // array de strings
  rating           Float?
  destacado        Boolean  @default(false)
  activo           Boolean  @default(true)
  orden            Int      @default(0) // orden manual en la portada (menor primero)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Restaurant {
  id               String   @id
  nombre           String
  tipo             String?  // restaurante, picada, bar, cafeteria, etc.
  descripcion      String
  especialidad     String?
  propietario      String?  // nombre del dueño (desde catastro)
  coordenadas      Json
  direccion        String?
  horario          Json?
  mediosPago       Json     @default("[]") // array de strings, ej. ["Efectivo", "Débito", "Crédito"]
  tags             Json     @default("[]") // array de strings
  imagenPrincipal  String?
  galeria          Json     @default("[]") // array de strings
  menuUrl          String?
  contacto         Json?    // e.g. { "telefono": "..." }
  activo           Boolean  @default(true)
  orden            Int      @default(0) // orden manual en la portada (menor primero)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Accommodation {
  id               String   @id
  nombre           String
  tipo             String?
  propietario      String?  // nombre del dueño (desde catastro)
  descripcion      String
  coordenadas      Json
  direccion        String?
  servicios        Json     @default("[]") // array de strings
  imagenPrincipal  String?
  galeria          Json     @default("[]") // array de strings
  contacto         Json?
  activo           Boolean  @default(true)
  orden            Int      @default(0) // orden manual en la portada (menor primero)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Event {
  id               String   @id
  nombre           String
  tipo             String   // fiesta-religiosa, feria, centro-evento, cultural
  descripcion      String
  descripcionLarga String?
  fecha            String?  // "20 de enero" / "Fines de semana"
  recurrente       Boolean  @default(true)
  coordenadas      Json?
  direccion        String?
  imagenPrincipal  String?
  galeria          Json     @default("[]") // array de strings
  tags             Json     @default("[]") // array de strings
  destacado        Boolean  @default(false)
  activo           Boolean  @default(true)
  orden            Int      @default(0) // orden manual en la portada (menor primero)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model EmergencyContact {
  id          String   @id // carabineros, bomberos, cesfam, etc.
  institucion String
  telefono    String
  direccion   String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
}

model Config {
  id               String   @id @default("default")
  categorias       Json     // Array of category objects
  updatedAt        DateTime @updatedAt
}

model TourRoute {
  id               String   @id
  slug             String   @unique
  nombre           String
  descripcion      String
  color            String   @default("#E63946")
  poiIds           Json     @default("[]") // Ordered list of POI IDs (Destinations, Restaurants, Accommodations, Events)
  duracionEstimada String?  // e.g. "2 a 3 horas"
  distanciaKm      Float?   // e.g. 7.5
  dificultad       String?  @default("Fácil")
  hitos            Json?    // Array of milestones [{ numero, titulo, descripcion }]
  consejos         Json?    // Array of practical tips [{ titulo, texto }]
  tiemposParada    Json?    // Extra minutes per stop, keyed by POI id: { [poiId]: minutos }
  mapaImagen       String?  // e.g. "/assets/images/mapa-ilustrado-ruta-condorito.png"
  destacada        Boolean  @default(false)
  activo           Boolean  @default(true)
  orden            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
  LECTOR
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  nombre              String
  password            String
  role                Role     @default(LECTOR)
  activo              Boolean  @default(true)
  /// true cuando la contraseña actual fue asignada por un admin (alta o reseteo)
  /// y el usuario todavía no elige la suya: se le exige cambiarla al entrar.
  mustChangePassword  Boolean  @default(false)
  /// Sube en cada cambio de contraseña. Un token de sesión firmado con una
  /// versión distinta a esta deja de ser válido, aunque no haya expirado.
  tokenVersion        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Textos editables del sitio público.
/// Solo guarda los textos que un editor cambió: el valor por defecto vive en
/// el código (src/lib/siteTexts.ts). Si esta tabla está vacía, el sitio se ve
/// exactamente igual que sin la funcionalidad.
model SiteText {
  key             String   @id
  value           String
  updatedAt       DateTime @updatedAt
  updatedById     String?
  updatedByEmail  String?
  updatedByNombre String?
}

/// Bitácora de cada cambio de texto: quién, cuándo, valor anterior y nuevo.
/// Permite auditar y restaurar cualquier versión previa.
model SiteTextRevision {
  id            String   @id @default(cuid())
  key           String
  valorAnterior String?
  valorNuevo    String
  accion        String   @default("editar") // editar | restaurar | original
  autorId       String?
  autorEmail    String?
  autorNombre   String?
  createdAt     DateTime @default(now())

  @@index([key, createdAt])
}

/// Apariencia editable del sitio: paleta de colores y tipografías.
/// Fila única (id fijo "default"). Solo guarda lo que un editor cambió: los
/// valores por defecto viven en el código (src/lib/theme.ts). Si esta tabla
/// está vacía, el sitio se ve exactamente igual que sin esta funcionalidad.
model ThemeConfig {
  id              String   @id @default("default")
  /// Hex del color dominante (rojo Condorito). Claro/oscuro se derivan solos.
  colorPrimario   String?
  /// Hex del color de acento (sol).
  colorAcento     String?
  /// Hex del fondo/papel base.
  colorFondo      String?
  /// Hex del texto/tinta base.
  colorTexto      String?
  /// Clave del catálogo de tipografías de texto (src/lib/theme.ts).
  fontBody        String?
  /// Clave del catálogo de tipografías de titulares (src/lib/theme.ts).
  fontDisplay     String?
  updatedAt       DateTime @updatedAt
  updatedByEmail  String?
  updatedByNombre String?
}

/// Destinatarios del aviso por correo cuando llega una Solicitud nueva
/// (consulta de /contacto o postulación de /sumate). Fila única (id fijo
/// "default"). Si esta tabla está vacía, se usa SOLICITUDES_EMAIL_TO del
/// .env como respaldo.
model NotificacionesConfig {
  id              String   @id @default("default")
  emails          Json     @default("[]") // array de strings
  updatedAt       DateTime @updatedAt
  updatedByEmail  String?
  updatedByNombre String?
}

/// Registro anónimo de visitas al sitio público (no al panel /admin).
/// No guarda IP ni datos personales: solo un id aleatorio de dispositivo
/// (visitorId, vive en localStorage) y uno de sesión (sessionId), para poder
/// distinguir "visitas" de "visitantes" sin identificar a nadie.
/// El país tampoco guarda la IP: se resuelve en el momento con geoip-lite
/// (base de datos offline, sin servicios de terceros) a partir de la IP de la
/// petición, y esa IP se descarta ahí mismo sin llegar a esta tabla.
model PageView {
  id        String   @id @default(cuid())
  path      String // ruta visitada, ej. "/destino/plaza-de-cumpeo"
  titulo    String? // título legible de la página al momento de la visita
  seccion   String // inicio | destino | ruta | mapa | categoria | historia | contacto | otro
  visitorId String // id anónimo por dispositivo (localStorage)
  sessionId String // id anónimo por sesión del navegador
  referrer  String? // dominio de origen (google.com, qr, etc.), sin querystring
  device    String? // movil | tablet | escritorio
  pais      String? // código ISO de país (ej. "CL"), resuelto con geoip-lite
  /// Solo tienen valor en las filas anteriores a que el despliegue dejara de
  /// empaquetar los datos de ciudad de geoip-lite; desde entonces llegan null.
  region    String?
  ciudad    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([seccion, createdAt])
  @@index([path, createdAt])
  @@index([visitorId, createdAt])
  @@index([pais, createdAt])
}

enum SolicitudTipo {
  RESTAURANTE
  ALOJAMIENTO
  DESTINO
  EVENTO
  CONSULTA
}

enum SolicitudEstado {
  NUEVA
  EN_REVISION
  APROBADA
  RECHAZADA
  PUBLICADA
}

/// Solicitudes que llegan desde el sitio público: emprendedores que piden
/// sumarse a la plataforma (/sumate) y consultas del formulario de contacto.
///
/// Los campos del negocio son deliberadamente los mismos que usa una ficha
/// publicada (Destination / Restaurant / Accommodation / Event): así el panel
/// puede abrir el formulario de creación ya relleno con lo que envió el
/// emprendedor, en vez de obligar a copiar el dato a mano.
model Solicitud {
  id     String          @id @default(cuid())
  tipo   SolicitudTipo
  estado SolicitudEstado @default(NUEVA)

  // ── Quién solicita ──
  solicitanteNombre   String
  solicitanteEmail    String
  solicitanteTelefono String?
  solicitanteRol      String? // dueño, encargado, familiar, etc.

  // ── Datos del lugar o negocio (vacíos en una consulta simple) ──
  nombre            String
  descripcion       String
  categoriaSugerida String? // categoría del destino / tipo de local / tipo de alojamiento
  especialidad      String?
  direccion         String?
  coordenadas       Json? // { lat, lng } marcado en el mapa
  horario           Json? // { apertura, cierre, descripcion }
  telefono          String?
  whatsapp          String?
  email             String?
  web               String?
  instagram         String?
  facebook          String?
  servicios         Json     @default("[]") // array de strings (alojamientos)
  mediosPago        Json     @default("[]") // array de strings (locales de comida)
  fecha             String? // eventos: "20 de enero", "Fines de semana"
  fotos             Json     @default("[]") // array de strings, URLs bajo /uploads/solicitudes/
  mensaje           String? // comentario libre del solicitante

  // ── Gestión interna del municipio ──
  notaInterna       String?
  revisadoPorId     String?
  revisadoPorNombre String?
  revisadoEn        DateTime?
  /// Ficha creada a partir de esta solicitud, para no publicarla dos veces.
  publicadoComoId   String?
  publicadoComoTipo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado, createdAt])
  @@index([tipo, createdAt])
  @@index([createdAt])
}
