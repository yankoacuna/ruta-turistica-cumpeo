generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Destination {
  id               String   @id
  slug             String   @unique
  nombre           String
  categoria        String
  descripcionCorta String
  descripcionLarga String?
  historia         String?
  coordenadas      Json     // { "lat": -35.267, "lng": -71.250 }
  direccion        String?
  horario          Json?
  duracionVisita   String?
  comoLlegar       String?
  tags             String[]
  imagenPrincipal  String?
  galeria          String[]
  rating           Float?
  destacado        Boolean  @default(false)
  activo           Boolean  @default(true)
  orden            Int      @default(0) // orden manual en la portada (menor primero)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Restaurant {
  id               String   @id
  nombre           String
  tipo             String?  // restaurante, picada, bar, cafeteria, etc.
  descripcion      String
  especialidad     String?
  propietario      String?  // nombre del dueño (desde catastro)
  coordenadas      Json
  direccion        String?
  telefono         String?  // Ej: "+56 9 6507 5887"
  whatsapp         String?  // Ej: "+56 9 6507 5887"
  horario          Json?
  mediosPago       String[] // ["Efectivo", "Débito", "Crédito"]
  tags             String[]
  imagenPrincipal  String?
  galeria          String[]
  menuUrl          String?
  contacto         Json?    // e.g. { "telefono": "..." }
  activo           Boolean  @default(true)
  orden            Int      @default(0) // orden manual en la portada (menor primero)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Accommodation {
  id               String   @id
  nombre           String
  tipo             String?
  propietario      String?  // nombre del dueño (desde catastro)
  descripcion      String
  coordenadas      Json
  direccion        String?
  telefono         String?
  whatsapp         String?
  servicios        String[]
  imagenPrincipal  String?
  galeria          String[]
  contacto         Json?
  activo           Boolean  @default(true)
  orden            Int      @default(0) // orden manual en la portada (menor primero)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Event {
  id               String   @id
  nombre           String
  tipo             String   // fiesta-religiosa, feria, centro-evento, cultural
  descripcion      String
  descripcionLarga String?
  fecha            String?  // "20 de enero" / "Fines de semana"
  recurrente       Boolean  @default(true)
  coordenadas      Json?
  direccion        String?
  imagenPrincipal  String?
  galeria          String[]
  tags             String[]
  destacado        Boolean  @default(false)
  activo           Boolean  @default(true)
  orden            Int      @default(0) // orden manual en la portada (menor primero)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model EmergencyContact {
  id          String   @id // carabineros, bomberos, cesfam, etc.
  institucion String
  telefono    String
  direccion   String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
}

model Config {
  id               String   @id @default("default")
  categorias       Json     // Array of category objects
  updatedAt        DateTime @updatedAt
}

model TourRoute {
  id               String   @id
  slug             String   @unique
  nombre           String
  descripcion      String
  color            String   @default("#E63946")
  poiIds           String[] // Ordered list of POI IDs (Destinations, Restaurants, Accommodations, Events)
  duracionEstimada String?  // e.g. "2 a 3 horas"
  distanciaKm      Float?   // e.g. 7.5
  dificultad       String?  @default("Fácil")
  hitos            Json?    // Array of milestones [{ numero, titulo, descripcion }]
  consejos         Json?    // Array of practical tips [{ titulo, texto }]
  tiemposParada    Json?    // Extra minutes per stop, keyed by POI id: { [poiId]: minutos }
  mapaImagen       String?  // e.g. "/assets/images/mapa-ilustrado-ruta-condorito.png"
  destacada        Boolean  @default(false)
  activo           Boolean  @default(true)
  orden            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
  LECTOR
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  nombre              String
  password            String
  role                Role     @default(LECTOR)
  activo              Boolean  @default(true)
  /// true cuando la contraseña actual fue asignada por un admin (alta o reseteo)
  /// y el usuario todavía no elige la suya: se le exige cambiarla al entrar.
  mustChangePassword  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Textos editables del sitio público.
/// Solo guarda los textos que un editor cambió: el valor por defecto vive en
/// el código (src/lib/siteTexts.ts). Si esta tabla está vacía, el sitio se ve
/// exactamente igual que sin la funcionalidad.
model SiteText {
  key             String   @id
  value           String
  updatedAt       DateTime @updatedAt
  updatedById     String?
  updatedByEmail  String?
  updatedByNombre String?
}

/// Bitácora de cada cambio de texto: quién, cuándo, valor anterior y nuevo.
/// Permite auditar y restaurar cualquier versión previa.
model SiteTextRevision {
  id            String   @id @default(cuid())
  key           String
  valorAnterior String?
  valorNuevo    String
  accion        String   @default("editar") // editar | restaurar | original
  autorId       String?
  autorEmail    String?
  autorNombre   String?
  createdAt     DateTime @default(now())

  @@index([key, createdAt])
}
